<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Vois</RootNamespace>
    <PackageId>Vois</PackageId>
    <Version>1.1.1</Version>
    <Authors>VOIS</Authors>
    <Company>VOIS</Company>
    <Description>VOIS SMS ve Ses API istemcisi: SMS/OTP gönderimi, tıkla-ara, çağrı geçmişi, ses kayıtları, webhook imza doğrulama.</Description>
    <PackageTags>vois;sms;otp;click-to-call;pbx;webhook;api-key</PackageTags>
    <PackageProjectUrl>https://docs.vois.com.tr/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/voistelekom/vois-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
